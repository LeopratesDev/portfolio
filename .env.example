# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Na Vercel: Project Settings → Environment Variables.

# Chave da API do Resend (https://resend.com/api-keys). Só é usada no servidor.
RESEND_API_KEY=

# Para onde as mensagens do formulário vão.
CONTACT_TO_EMAIL=lp.prates7@gmail.com

# Remetente. "onboarding@resend.dev" funciona sem domínio próprio, mas só
# entrega para o e-mail dono da conta Resend.
CONTACT_FROM_EMAIL=Portfólio <onboarding@resend.dev>
